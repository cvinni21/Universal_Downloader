{
  "manifest_version": 3,
  "name": "Universal Downloader Bridge",
  "description": "Envia links e downloads do navegador para o Universal Downloader.",
  "version": "1.0.0",
  "homepage_url": "https://github.com/cvinni21/Universal_Downloader",
  "key": "",
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Universal Downloader",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-downloader@cvinni21",
      "strict_min_version": "115.0"
    }
  }
}
